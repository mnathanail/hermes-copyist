# ── Server ──────────────────────────────────────────────
PORT=3000
LOG_DIR=./logs

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/hermes_copyist

# ── Solana ──────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JITO_RPC_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions

# ── Trading wallet ──────────────────────────────────────
# SECURITY NOTE (decided during planning): the private key lives ONLY
# here, in this process's environment. It is never written to the DB,
# never sent to the dashboard, never logged. This is the "simple, less
# secure" custody option chosen deliberately for v1 — rotate this key
# if this file or server is ever shared or exposed.
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=

# ── Signal source (Phase 1) ─────────────────────────────
# PumpPortal data websocket, metered (0.01 SOL / 10k events). Same key as
# ArgusTrench. ONE connection per process — never one per wallet.
PUMPPORTAL_API_KEY=

# ── Smoke test only (npm run smoke-test) ────────────────
SMOKE_TEST_WALLETS=3JQvkiF2GKfca3ggMPRwTHmzvnj6emReuSFwSrBBonp5,4ugDhHJ8XDXAeABmrNmGffFaLbJb9BkPyiFGVSV9ocwo
# SMOKE_TEST_OUT_DIR=./logs
# SMOKE_TEST_SUMMARY_MIN=5

# ── Legacy (removed in Phase 2 with the old walletWatcher) ──
# src/config/env.ts still requires this at boot; any non-empty value works
# for the smoke test, which does not load src/config/env.ts.
COINVERA_API_KEY=
SOLANA_PORTAL_URL=https://api.solanaportal.io/api/trading
