{
  "name": "hermes-copyist",
  "version": "0.1.0",
  "description": "Multi-wallet Solana copy-trading execution engine with configurable exit strategies and auto/manual trading modes.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "migrate": "node -e \"require('dotenv/config'); const {execSync}=require('child_process'); execSync('psql \\\"'+process.env.DATABASE_URL+'\\\" -f src/db/migrations/001_init.sql', {stdio:'inherit'})\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "pino": "^9.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
